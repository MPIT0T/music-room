DB_NAME=musicroom
DB_USER=musicroom
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too
JWT_SECRET=change_me
APP_BASE_URL=http://localhost:3000
# fatal, error, warn, info, debug ou trace
LOG_LEVEL=info

# Google OAuth : un client par plateforme (Google Cloud > APIs & Services > Credentials).
# Identifiants publics. Ne JAMAIS mettre le client secret (GOCSPX-...) ici.
# Client "Web application" : Flutter web + serverClientId de l'app Android
GOOGLE_CLIENT_ID_WEB=
# Client "Android" : lié au package name et au SHA-1 de la clé de signature
GOOGLE_CLIENT_ID_ANDROID=

# Prod uniquement
# DOMAIN=music.example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
