DB_NAME=musicroom
DB_USER=musicroom
# Passwords and secret generated by `make .env` (openssl rand -hex).
# JWT_SECRET: 32 characters minimum, otherwise the api refuses to start.
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
# Password of the 4 demo accounts created by `make seed`
SEED_PASSWORD=
APP_BASE_URL=http://localhost:3000
# fatal, error, warn, info, debug or trace
LOG_LEVEL=info

# Google OAuth: one client per platform (Google Cloud > APIs & Services > Credentials).
# Public identifiers. NEVER put the client secret (GOCSPX-...) here.
# "Web application" client: Flutter web + serverClientId of the Android app
GOOGLE_CLIENT_ID_WEB=
# "Android" client: bound to the package name and the SHA-1 of the signing key
GOOGLE_CLIENT_ID_ANDROID=

# Production only
# SMTP: in dev, Mailpit is used by default (http://localhost:8025). In prod, TLS is required.
# DOMAIN=music.example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
